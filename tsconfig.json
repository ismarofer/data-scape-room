{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx", "types": ["node"],
    "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src", "apps/*/src", "scripts", "e2e"]
}
